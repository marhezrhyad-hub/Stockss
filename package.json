{
  "name": "breakout-radar",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-data": "tsx scripts/generate-market-data.ts",
    "prebuild": "tsx scripts/generate-market-data.ts",
    "build": "tsc -b && vite build",
